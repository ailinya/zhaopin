# ===== LLM 配置（OpenAI 兼容接口）=====
# 支持 DeepSeek / Qwen / GLM 等
LLM_PROVIDER=deepseek
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1

# ===== 数据库 =====
DATABASE_URL=sqlite:///./backend/interview.db

# ===== 文件存储 =====
STORAGE_PATH=./backend/storage

# ===== JWT 配置 =====
# 生产环境必须用强随机字符串（至少 32 字节）
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-string-min-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
# 开发环境
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
# 生产环境（替换为你的域名）
# CORS_ORIGINS=["https://your-domain.com"]

# ===== 候选人 Token =====
CANDIDATE_TOKEN_LENGTH=32

# ===== Whisper 配置 =====
WHISPER_MODEL=base
# WHISPER_MODEL=large-v3  # GPU 可用时启用
WHISPER_DEVICE=auto
# WHISPER_DEVICE=cuda    # 强制 GPU
# WHISPER_DEVICE=cpu     # 强制 CPU

# ===== 日志 =====
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG  # 开发时

# ===== 服务端口 =====
API_PORT=8000